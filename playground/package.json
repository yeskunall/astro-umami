{
  "name": "playground",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "astro check && astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "pnpm run test:default && pnpm run test:auto-pageview && pnpm run test:enabled-in-development",
    "test:auto-pageview": "ASTRO_DEV_BACKGROUND=0 PLAYGROUND_SCENARIO=auto-pageview playwright test tests/auto-pageview",
    "test:default": "ASTRO_DEV_BACKGROUND=0 PLAYGROUND_SCENARIO=default playwright test tests/default",
    "test:enabled-in-development": "ASTRO_DEV_BACKGROUND=0 PLAYGROUND_SCENARIO=enabled-in-development playwright test tests/enabled-in-development"
  },
  "dependencies": {
    "@yeskunall/astro-umami": "workspace:*",
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "playwright": "1.64.1",
    "typescript": "catalog:"
  }
}
