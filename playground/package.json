{
  "name": "playground",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "astro check && astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "pnpm run test:default && pnpm run test:umami-enabled",
    "test:default": "ASTRO_DEV_BACKGROUND=0 PLAYGROUND_SCENARIO=default playwright test tests/default",
    "test:umami-enabled": "ASTRO_DEV_BACKGROUND=0 PLAYGROUND_SCENARIO=umami-enabled playwright test tests/umami-enabled"
  },
  "dependencies": {
    "@yeskunall/astro-umami": "workspace:*",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "playwright": "1.64.1",
    "typescript": "catalog:"
  }
}
